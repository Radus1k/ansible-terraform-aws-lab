# Copy to terraform.tfvars and adjust. terraform.tfvars is auto-loaded.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region   = "eu-central-1"
project_name = "tf-ansible-lab"
environment  = "dev"
owner        = "your-name"

# Path to the PUBLIC half of an SSH keypair that already exists locally.
# Generate one with:  ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519
public_key_path = "~/.ssh/id_ed25519.pub"

# When true, port 22 is opened only to the public IP running `terraform apply`.
restrict_ssh_to_my_ip = true

# CIDR allowed to reach ports 80/443. Leave wide for a public demo,
# or lock to your IP, e.g. "203.0.113.7/32".
allow_http_from = "0.0.0.0/0"

instance_type = "t3.micro"
